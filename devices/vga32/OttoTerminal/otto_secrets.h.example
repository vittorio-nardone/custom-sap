/*
 * Optional WiFi seed for OttoTerminal.
 * Copy to otto_secrets.h and edit if you want a one-time NVS seed at first boot.
 * Runtime config: F11 (scan + password) saves to non-volatile Preferences.
 *
 * If NVS already has an SSID, this file is ignored.
 */
#pragma once

#define OTTO_WIFI_SSID     "YOUR_SSID"
#define OTTO_WIFI_PASSWORD "YOUR_PASSWORD"
